# Existing bot configuration
DISCORD_TOKEN=

# Roblox OAuth 2.0
# Create the app in Roblox Creator Dashboard > OAuth 2.0 Apps.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Must exactly match the redirect URL registered in the Roblox OAuth app.
# Example: https://your-domain.example/roblox/callback
ROBLOX_REDIRECT_URI=

# Discord server and role that receive verification.
ROBLOX_GUILD_ID=
ROBLOX_VERIFIED_ROLE_ID=

# Optional: the web server uses PORT automatically (defaults to 3000).
PORT=3000
